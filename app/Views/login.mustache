{{> header}}
<h1 class="page-heading narrow">Log in</h1>
{{#has_errors}}
<ul class="errors narrow" role="alert">
    {{#errors}}
    <li>{{.}}</li>
    {{/errors}}
</ul>
{{/has_errors}}
<form method="post" action="/login" class="auth-form card">
    <input type="hidden" name="csrf_token" value="{{csrf_token}}">
    <label for="username">Username</label>
    <input id="username" name="username" type="text" value="{{old_username}}" autocomplete="username" required>
    <label for="password">Password</label>
    <input id="password" name="password" type="password" autocomplete="current-password" required>
    <button type="submit" class="btn btn-primary btn-block">Log in</button>
</form>
<p>No account yet? <a href="/register">Register</a>.</p>
{{> footer}}
